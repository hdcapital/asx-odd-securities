# Copy this file to ".env" and fill in. Only needed if you want the report emailed
# when you run it on your own PC. (On GitHub these go in Settings > Secrets.)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_TO=you@example.com

# Optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# BBSW_3M=0.036
